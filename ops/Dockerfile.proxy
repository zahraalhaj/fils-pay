# Edge proxy image: nginx serving the built web and admin apps and
# forwarding /v1 to the api. Build context is the repository root:
#   docker build -f ops/Dockerfile.proxy -t filspay-proxy .
FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/admin ./apps/admin
COPY apps/api/package.json ./apps/api/package.json
COPY apps/reporting/package.json ./apps/reporting/package.json
RUN npm ci --no-audit --no-fund
RUN npm run build -w apps/web \
 && npm run build -w apps/admin -- --base=/admin/

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY ops/nginx/filspay.conf /etc/nginx/conf.d/filspay.conf
COPY ops/nginx/snippets /etc/nginx/snippets
COPY --from=build /src/apps/web/dist /usr/share/nginx/html/web
COPY --from=build /src/apps/admin/dist /usr/share/nginx/html/admin
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
