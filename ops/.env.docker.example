# Copy to ops/.env.docker (git-ignored) and fill in. Never commit the real
# file: it holds secrets.
NODE_ENV=development
PORT=3000

# Acquirer callback signing secret (from the acquirer's portal).
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Optional: email login codes. Local: Mailpit on smtp://host.docker.internal:1025
# Resend: smtps://resend:<API_KEY>@smtp.resend.com:465 (needs a verified domain)
SMTP_URL=
# Login codes are shown on the login screen by default, production included
# (a password alone then signs in). Set to false to turn that off.
# OTP_DEV_EXPOSE=false
