# Copy to ops/.env.docker (git-ignored) and fill in. Never commit the real
# file: it holds secrets.
NODE_ENV=development
PORT=3000

# Acquirer callback signing secret (from the acquirer's portal).
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Login codes are emailed; required when NODE_ENV=production.
# Local: Mailpit on smtp://host.docker.internal:1025
SMTP_URL=
