# Copy to ops/.env.docker (git-ignored) and fill in. Never commit the real
# file: it holds secrets.
NODE_ENV=development
PORT=3000

# Acquirer callback signing secret (from the acquirer's portal).
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Login codes are emailed; required when NODE_ENV=production unless
# OTP_SHOW_ON_SCREEN=true. Local: Mailpit on smtp://host.docker.internal:1025
# Resend: smtps://resend:<API_KEY>@smtp.resend.com:465 (needs a verified domain)
SMTP_URL=
# Demo only: show login codes on the login screen instead of emailing them.
# A password alone then signs in. Remove once SMTP_URL is set.
OTP_SHOW_ON_SCREEN=false
