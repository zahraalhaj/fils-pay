# Image for api, reporting, migrate and seed. Build context is the repo root
# (see docker-compose.yml). Services run TypeScript directly with tsx, the
# same way they run in development.
FROM node:24-bookworm-slim

WORKDIR /app

# Workspace manifests first so `npm ci` is cached until dependencies change.
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/reporting ./apps/reporting
COPY apps/web/package.json ./apps/web/package.json
COPY apps/admin/package.json ./apps/admin/package.json
RUN npm ci --no-audit --no-fund

COPY db ./db
COPY scripts ./scripts

USER node
