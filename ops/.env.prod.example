# Copy to ops/.env.prod (never committed) and fill in. Generate secrets with:
#   openssl rand -hex 32        (tokens, passwords)
#   openssl rand -base64 32     (WEBHOOK_SECRET_ENCRYPTION_KEY: exactly 32 bytes)
POSTGRES_PASSWORD=
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
CHECKOUT_BASE_URL=https://filspay-dara-zahraalhaj27.dilmune.app

# Login codes are shown on the login screen (default; a password alone signs
# in, and the API warns at boot). OTP_DEV_EXPOSE=false turns that off, after
# which users need SMTP_URL to receive a code.
# Optional email instead: SMTP_URL (e.g. Resend smtps://resend:<KEY>@smtp.resend.com:465).
OTP_DEV_EXPOSE=true
SMTP_URL=
OTP_FROM_EMAIL=

# Where the proxy listens on the host. 127.0.0.1 when a host nginx/TLS edge
# forwards to it; 0.0.0.0 only if this proxy is the public edge itself.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
